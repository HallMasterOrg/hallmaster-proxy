# --- Proxy ---
PROXY_HOSTNAME=hallmaster-proxy
PROXY_PORT=443
PROXY_HEALTH_PORT=8081
PROXY_SSL_CA_CERT_PATH=/app/cert/proxy-ca.crt # container path
PROXY_SSL_CA_KEY_PATH=/app/cert/proxy-ca.pem # container path
PROXY_DNS_SERVER=8.8.8.8:53 # (Google Public DNS)

# --- Bots ---
DISCORD_BOT_TOKEN=""
TOTAL_SHARDS=2
SHARD_ID_LIST=0,1
