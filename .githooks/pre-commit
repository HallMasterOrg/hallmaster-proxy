#!/bin/sh
# Enabled per clone with: git config core.hooksPath .githooks
set -eu

# Added/changed paths only: removing a secret from the index must still work.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

secrets=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env(\.[^/]*)?$|\.pem$|\.key$' | grep -v '\.example$' || true)
if [ -n "$secrets" ]; then
  echo "pre-commit: refusing to commit secrets:" >&2
  printf '  %s\n' $secrets >&2
  exit 1
fi

printf '%s\n' "$staged" | grep -qE '\.go$|(^|/)go\.(mod|sum)$|\.golangci\.yml$' || exit 0

if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "pre-commit: golangci-lint not found (brew install golangci-lint)" >&2
  exit 1
fi

# Lints the working tree, not just the staged content.
exec "$(git rev-parse --show-toplevel)/scripts/lint.sh"
